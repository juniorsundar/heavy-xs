+//! Disposable fancy-regex evidence adapter. No pattern rewriting or PCRE2 fallback.
+use std::{cell::RefCell, rc::Rc};
+use fancy_regex::{CompileError, Error, Regex, RegexBuilder, RegexInput, RuntimeError};
+use mlua::{Lua, Table, Value, Variadic, MultiValue, UserData, Result as LR, Error as LE};
+use crate::spike_replacement;
+
+const ANCHORED: u32 = 0x80000000;
+#[derive(Clone, Copy)]
+struct Limits { work: usize, output: usize }
+struct Pair { work: usize, re: Regex, nonempty: Option<Option<Regex>> }
+struct Pattern { source: String, flags: String, names: Vec<(String,usize)>, pair: RefCell<Pair> }
+struct Handle(Rc<Pattern>);
+impl UserData for Handle {}
+type Spans = Vec<Option<(usize,usize)>>;
+
+fn build(source: &str, flags: &str, work: usize, nonempty: bool) -> Result<Regex, Error> {
+    RegexBuilder::new(source).case_insensitive(flags.contains('i'))
+        .multi_line(flags.contains('m')).dot_matches_new_line(flags.contains('s'))
+        .backtrack_limit(work).delegate_size_limit(2 * 1024 * 1024)
+        .delegate_dfa_size_limit(2 * 1024 * 1024).find_not_empty(nonempty)
+        .allow_input_assertion_overrides(true).build()
+}
+fn compile(source: &str, flags: &str, work: usize) -> Result<Rc<Pattern>,Error> {
+    let re = build(source, flags, work, false)?;
+    let names = re.capture_names().enumerate().filter_map(|(i,n)| n.map(|n|(n.to_owned(),i))).collect();
+    Ok(Rc::new(Pattern { source: source.into(), flags: flags.into(), names,
+        pair: RefCell::new(Pair { work, re, nonempty: None }) }))
+}
+fn string(lua: &Lua, value: Option<&Value>) -> LR<mlua::LuaString> {
+    lua.coerce_string(value.cloned().unwrap_or(Value::Nil))?
+        .ok_or_else(||LE::runtime("string expected"))
+}
+fn valid(s: &mlua::LuaString) -> LR<mlua::BorrowedStr> {
+    s.to_str().map_err(|_|LE::runtime("REGEX_UTF8_ERROR: invalid UTF-8"))
+}
+fn number(value: Option<&Value>) -> f64 {
+    match value { Some(Value::Integer(n))=>*n as f64, Some(Value::Number(n))=>*n, _=>0.0 }
+}
+fn offset(v: Option<&Value>, text: &str) -> LR<usize> {
+    let n = v.map(|v|number(Some(v))).unwrap_or(1.0);
+    if !n.is_finite() { return Err(LE::runtime("REGEX_OFFSET_ERROR: non-finite offset")); }
+    let one = if n>0.0 { n as usize } else if n==0.0 || n < -(text.len() as f64) {1}
+        else {(text.len() as f64+n+1.0) as usize};
+    let pos = one.saturating_sub(1);
+    if pos>text.len() || !text.is_char_boundary(pos) {
+        return Err(LE::runtime("REGEX_OFFSET_ERROR: offset beyond end or inside UTF-8"));
     }
+    Ok(pos)
