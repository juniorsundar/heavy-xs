@@ -0,0 +1,18 @@
+use fancy_regex::{RegexBuilder, RegexInput};
+fn main() {
+    for unicode in [true, false] {
+        for (pattern, subject) in [(r"\w","é"),(r"\d","٣"),(r"\s","\u{a0}"),
+            (r".","é"),(r"[^a]","é"),(r"(?i)é","É"),(r"\h"," "),(r"\h","a"),
+            (r"[\n,;\)\]\}\. ]",")"),(r"[\n,;\)\]\}\. ]","}"),
+            (r"\Qa.b\E","a.b"),(r"(*MARK:tag)(a)","a")] {
+            let result = RegexBuilder::new(pattern).unicode_mode(unicode).build()
+                .map(|r|r.find(subject).map(|m|m.map(|m|(m.start(),m.end()))));
+            println!("unicode={unicode} pattern={pattern:?} subject={subject:?} result={result:?}");
+        }
+    }
+    for pattern in [r"^a",r"\Aa",r"a$",r"a\z"] {
+        let r=RegexBuilder::new(pattern).build().unwrap();
+        let r=r.captures_input(RegexInput::new("a").start_text(false).end_text(false));
+        println!("assertion override pattern={pattern:?} match={:?}",r.map(|x|x.is_some()));
+    }
+}
