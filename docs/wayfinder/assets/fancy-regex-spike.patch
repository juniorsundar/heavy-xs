+    let limits=Rc::new(RefCell::new(Limits {work:1_000_000,output:8*1024*1024}));
+    let l=limits.clone();
+    module.set("set_limits",lua.create_function(move|_,(work,output):(usize,usize)| {
+        if work==0 || output==0 {return Err(LE::runtime("REGEX_LIMIT_ERROR: positive limits required"));}
+        *l.borrow_mut()=Limits{work,output}; Ok(())
+    })?)?;
+    let l=limits.clone(); let m=module.clone();
+    module.set("compile",lua.create_function(move|lua,a:Variadic<Value>| {
+        let raw=string(lua,a.first())?;
+        let source=match valid(&raw) { Ok(s)=>s, Err(_)=>return Ok(MultiValue::from_vec(vec![
+            Value::Nil,Value::String(lua.create_string("regex compilation failed: invalid UTF-8")?)])) };
+        let flags=match a.get(1) {Some(v)=>Some(string(lua,Some(v))?),None=>None};
+        let flags=match flags.as_ref(){Some(f)=>['i','m','s'].into_iter()
+            .filter(|c|f.as_bytes().contains(&(*c as u8))).collect(),None=>String::new()};
+        match compile(&source,&flags,l.borrow().work) {
+            Ok(p)=>{let t=lua.create_table()?;t.raw_set(1,lua.create_userdata(Handle(p))?)?;
+                t.set_metatable(Some(m.clone()))?;Ok(MultiValue::from_vec(vec![Value::Table(t)]))},
+            Err(e)=>Ok(MultiValue::from_vec(vec![Value::Nil,Value::String(lua.create_string(format!("regex compilation failed: {e}"))?)])),
+        }
+    })?)?;
+    let l=limits.clone();
+    module.set("cmatch",lua.create_function(move|lua,a:Variadic<Value>| {
+        let lim=*l.borrow(); let p=pattern(lua,a.first(),lim.work)?;
+        let raw=string(lua,a.get(1))?; let text=valid(&raw)?;
+        let start=offset(a.get(2),&text)?; let suffix=&text[start..];
+        let opts=number(a.get(3)) as u32; let mut b=Budget::new(lim);
+        let mut c=captures(&p,suffix,0,opts,opts&4!=0,&mut b)?;
+        if opts&8!=0 && c.as_ref().and_then(|c|c[0])==Some((0,0)) {
+            c=captures(&p,suffix,0,opts|ANCHORED,true,&mut b)?;
+            if c.is_none() && opts&ANCHORED==0 {
+                if let Some(n)=advance(suffix,0){c=captures(&p,suffix,n,opts,false,&mut b)?;}
+            }
+        }
+        let Some(c)=c else{return Ok(MultiValue::new())};
+        let mut out=Vec::new();
+        for span in &c[..trim(&c)] {
+            match span {Some((s,e))=>{out.push(Value::Integer((s+start+1) as i64));out.push(Value::Integer((e+start+1) as i64));},
+                None=>{out.push(Value::Nil);out.push(Value::Nil);}}
+        }
+        Ok(MultiValue::from_vec(out))
+    })?)?;
+    let l=limits.clone();
+    module.set("gmatch",lua.create_function(move|lua,a:Variadic<Value>| {
+        let lim=*l.borrow(); let p=pattern(lua,a.first(),lim.work)?;
+        let raw=string(lua,a.get(1))?; let subject=valid(&raw)?.to_string();
+        let start=offset(a.get(2),&subject)?;
+        let state=Rc::new(RefCell::new((start,false,false,Budget::new(lim))));
+        lua.create_function(move|lua,()| {
+            let mut st=state.borrow_mut(); if st.2{return Ok(MultiValue::new())}
+            let (ref mut pos,ref mut retry,ref mut done,ref mut b)=*st;
+            let Some(c)=next_match(&p,&subject,pos,retry,b)? else {*done=true;return Ok(MultiValue::new())};
+            let (s,z)=c[0].unwrap(); *pos=z; *retry=s==z;
+            strings(lua,&subject,&c)
+        })
+    })?)?;
+    let l=limits.clone();
+    module.set("gsub",lua.create_function(move|lua,a:Variadic<Value>| {
+        let lim=*l.borrow(); let p=pattern(lua,a.first(),lim.work)?;
+        let raw=string(lua,a.get(1))?;let subject=valid(&raw)?;
+        let replacement=string(lua,a.get(2))?;let replacement=valid(&replacement)?;
+        let limit=(number(a.get(3)) as i64).max(0) as usize;
+        let (out,n)=substitute(&p,&subject,&replacement,limit,lim)?;
+        Ok((lua.create_string(out)?,n))
+    })?)?;
+    for (name,value) in [("ANCHORED",ANCHORED),("ENDANCHORED",ANCHORED),("NOTBOL",1),
+        ("NOTEOL",2),("NOTEMPTY",4),("NOTEMPTY_ATSTART",8)] {module.set(name,value)?;}
+    module.set("__name","regex")?;
     Ok(module)
 }
diff --git a/rust/src/spike_replacement.rs b/rust/src/spike_replacement.rs
new file mode 100644
index 00000000..84cadd94
--- /dev/null
+++ b/rust/src/spike_replacement.rs
@@ -0,0 +1,581 @@
+//! Disposable spike: PCRE2-style *extended replacement template* interpreter.
+//!
+//! Not production. This only interprets the replacement string against
+//! precomputed match spans; matching lives elsewhere (fancy-regex). It is
+//! sized to exercise the fixtures in
+//! `docs/wayfinder/assets/regex-replacement-cases.lua`.
+//!
+//! shortcut: coverage is limited to the forms those fixtures assert plus the
+//! PCRE2 escapes they use. `(*MARK)` patterns will not compile in fancy-regex,
+//! so this interface cannot carry a mark and `${*MARK}` always expands empty.
+//! Upgrade when the corpus grows.
+
+pub fn expand(
+    template: &str,
+    subject: &str,
+    spans: &[Option<(usize, usize)>],
+    names: &[(String, usize)],
+    max_bytes: usize,
+) -> Result<String, String> {
+    let chars: Vec<char> = template.chars().collect();
+    let ctx = Ctx { subject, spans, names };
+    let mut st = State { out: String::new(), max: max_bytes, persistent: 0, oneshot: 0 };
+    run(&chars, &ctx, &mut st, 0)?;
+    Ok(st.out)
+}
+
+struct Ctx<'a> {
+    subject: &'a str,
+    spans: &'a [Option<(usize, usize)>],
+    names: &'a [(String, usize)],
+}
+
+struct State {
+    out: String,
+    max: usize,
+    persistent: u8, // 0 | b'U' | b'L'
+    oneshot: u8,    // 0 | b'u' | b'l'
+}
+
+fn terr(m: impl Into<String>) -> String {
+    format!("REGEX_TEMPLATE_ERROR: {}", m.into())
+}
+
+impl<'a> Ctx<'a> {
+    /// `Err` only when the group index cannot exist; `Ok(None)` is a
+    /// non-participating (unset) group.
+    fn group(&self, idx: usize) -> Result<Option<&'a str>, String> {
+        if idx >= self.spans.len() {
+            return Err(terr(format!("unknown group {}", idx)));
+        }
+        Ok(self.spans[idx].and_then(|(s, e)| self.subject.get(s..e)))
+    }
+    fn named(&self, name: &str) -> Result<usize, String> {
+        self.names
+            .iter()
+            .find(|(n, _)| n == name)
+            .map(|(_, i)| *i)
+            .ok_or_else(|| terr(format!("unknown group name {}", name)))
+    }
+    fn whole(&self) -> Result<(usize, usize), String> {
+        self.spans.first().copied().flatten().ok_or_else(|| terr("no whole match"))
+    }
+}
+
+fn group_value<'a>(ctx: &Ctx<'a>, idx: usize) -> Result<&'a str, String> {
+    ctx.group(idx)?.ok_or_else(|| terr(format!("unset group {}", idx)))
+}
+
+impl State {
+    fn raw(&mut self, c: char) -> Result<(), String> {
+        if self.out.len() + c.len_utf8() > self.max {
+            return Err(format!("REGEX_OUTPUT_LIMIT: {} bytes", self.max));
+        }
+        self.out.push(c);
+        Ok(())
+    }
+    fn emit(&mut self, c: char) -> Result<(), String> {
+        let f = if self.oneshot != 0 { std::mem::take(&mut self.oneshot) } else { self.persistent };
+        match f {
+            b'U' | b'u' => self.emit_iter(c.to_uppercase()),
+            b'L' | b'l' => self.emit_iter(c.to_lowercase()),
+            _ => self.raw(c),
+        }
+    }
+    fn emit_str(&mut self, s: &str) -> Result<(), String> {
+        for c in s.chars() {
+            self.emit(c)?;
+        }
+        Ok(())
+    }
+    fn emit_iter<I: Iterator<Item = char>>(&mut self, it: I) -> Result<(), String> {
+        for c in it {
+            self.raw(c)?;
+        }
+        Ok(())
+    }
+}
+
+fn run(tpl: &[char], ctx: &Ctx, st: &mut State, depth: usize) -> Result<(), String> {
+    if depth > 32 {
+        return Err(terr("template nesting too deep"));
+    }
+    let mut i = 0;
+    while i < tpl.len() {
+        match tpl[i] {
+            '$' => i = dollar(tpl, i, ctx, st, depth)?,
+            '\\' => i = backslash(tpl, i, ctx, st)?,
+            c => {
+                st.emit(c)?;
+                i += 1;
+            }
+        }
+    }
+    Ok(())
+}
+
+fn dollar(tpl: &[char], i: usize, ctx: &Ctx, st: &mut State, depth: usize) -> Result<usize, String> {
+    let j = i + 1;
+    let c = *tpl.get(j).ok_or_else(|| terr("dangling $"))?;
+    match c {
+        '$' => {
+            st.emit('$')?;
+            Ok(j + 1)
+        }
+        '&' => {
+            let (s, e) = ctx.whole()?;
+            st.emit_str(ctx.subject.get(s..e).unwrap_or(""))?;
+            Ok(j + 1)
+        }
+        '`' => {
+            let (s, _) = ctx.whole()?;
+            st.emit_str(ctx.subject.get(..s).unwrap_or(""))?;
+            Ok(j + 1)
+        }
+        '\'' => {
+            let (_, e) = ctx.whole()?;
+            st.emit_str(ctx.subject.get(e..).unwrap_or(""))?;
+            Ok(j + 1)
+        }
+        '_' => {
+            st.emit_str(ctx.subject)?;
+            Ok(j + 1)
+        }
+        '{' => braced(tpl, j, ctx, st, depth),
+        '<' => {
+            let (name, next) = angle(tpl, j)?;
+            let v = group_value(ctx, ctx.named(&name)?)?;
+            st.emit_str(v)?;
+            Ok(next)
+        }
+        '0'..='9' => {
+            let (idx, next) = digits(tpl, j);
+            let v = group_value(ctx, idx)?;
+            st.emit_str(v)?;
+            Ok(next)
+        }
+        c if c.is_ascii_alphabetic() || c == '_' => {
+            let (name, next) = ident(tpl, j);
+            let v = group_value(ctx, ctx.named(&name)?)?;
+            st.emit_str(v)?;
+            Ok(next)
+        }
+        _ => Err(terr("unknown $ form")),
+    }
+}
+
+enum Ref {
+    Group(usize),
+    Mark,
+}
+
+fn braced(tpl: &[char], j: usize, ctx: &Ctx, st: &mut State, depth: usize) -> Result<usize, String> {
+    let close = find_brace(tpl, j)?;
+    let content = &tpl[j + 1..close];
+    let (refc, op) = split_op(content);
+    let rf = parse_ref(refc, ctx)?;
+    match op {
+        None => match rf {
+            Ref::Mark => {}
+            Ref::Group(i) => st.emit_str(group_value(ctx, i)?)?,
+        },
+        Some(('-', rest)) => match rf {
+            Ref::Mark => run(rest, ctx, st, depth + 1)?,
+            Ref::Group(i) => match ctx.group(i)? {
+                Some(v) => st.emit_str(v)?,
+                None => run(rest, ctx, st, depth + 1)?,
+            },
+        },
+        Some(('+', rest)) => {
+            let (setp, unsetp) = split_colon(rest).ok_or_else(|| terr("expected set:unset"))?;
+            let isset = match rf {
+                Ref::Mark => false,
+                Ref::Group(i) => ctx.group(i)?.is_some(),
+            };
+            if isset {
+                run(setp, ctx, st, depth + 1)?;
+            } else {
+                run(unsetp, ctx, st, depth + 1)?;
+            }
+        }
+        Some(_) => return Err(terr("bad operator")),
+    }
+    Ok(close + 1)
+}
+
+fn parse_ref(r: &[char], ctx: &Ctx) -> Result<Ref, String> {
+    if r.is_empty() {
+        return Err(terr("empty braced reference"));
+    }
+    if r == &['*', 'M', 'A', 'R', 'K'][..] {
+        return Ok(Ref::Mark);
+    }
+    if r.iter().all(|c| c.is_ascii_digit()) {
+        let mut n = 0usize;
+        for c in r {
+            n = n.saturating_mul(10).saturating_add((*c as usize) - ('0' as usize));
+        }
+        return Ok(Ref::Group(n));
+    }
+    if (r[0].is_ascii_alphabetic() || r[0] == '_')
+        && r.iter().all(|c| c.is_ascii_alphanumeric() || *c == '_')
+    {
+        return Ok(Ref::Group(ctx.named(&r.iter().collect::<String>())?));
+    }
+    Err(terr("bad braced reference"))
+}
+
+/// Finds the `}` matching the `{` at `open`, accounting for nested `${...}`.
+fn find_brace(tpl: &[char], open: usize) -> Result<usize, String> {
+    let mut depth = 0i32;
+    for k in open..tpl.len() {
+        match tpl[k] {
+            '{' => depth += 1,
+            '}' => {
+                depth -= 1;
+                if depth == 0 {
+                    return Ok(k);
+                }
+            }
+            _ => {}
+        }
+    }
+    Err(terr("missing closing brace"))
+}
+
+/// Splits `${ref}` / `${ref:-...}` / `${ref:+...}` at the top-level operator.
+fn split_op(content: &[char]) -> (&[char], Option<(char, &[char])>) {
+    let mut depth = 0i32;
+    for k in 0..content.len().saturating_sub(1) {
+        match content[k] {
+            '{' => depth += 1,
+            '}' => depth -= 1,
+            ':' if depth == 0 && (content[k + 1] == '-' || content[k + 1] == '+') => {
+                return (&content[..k], Some((content[k + 1], &content[k + 2..])));
+            }
+            _ => {}
+        }
+    }
+    (content, None)
+}
+
+/// Splits the conditional's `set:unset` part at the first top-level `:`.
+fn split_colon(rest: &[char]) -> Option<(&[char], &[char])> {
+    let mut depth = 0i32;
+    for k in 0..rest.len() {
+        match rest[k] {
+            '{' => depth += 1,
+            '}' => depth -= 1,
+            ':' if depth == 0 => return Some((&rest[..k], &rest[k + 1..])),
+            _ => {}
+        }
+    }
+    None
+}
+
+fn digits(tpl: &[char], start: usize) -> (usize, usize) {
+    let mut k = start;
+    let mut n = 0usize;
+    while k < tpl.len() && tpl[k].is_ascii_digit() {
+        n = n.saturating_mul(10).saturating_add((tpl[k] as usize) - ('0' as usize));
+        k += 1;
+    }
+    (n, k)
+}
+
+fn ident(tpl: &[char], start: usize) -> (String, usize) {
+    let mut k = start;
+    while k < tpl.len() && (tpl[k].is_ascii_alphanumeric() || tpl[k] == '_') {
+        k += 1;
+    }
+    (tpl[start..k].iter().collect(), k)
+}
+
+/// Reads `<name>` or `<number>` starting at the `<`.
+fn angle(tpl: &[char], start: usize) -> Result<(String, usize), String> {
+    let mut k = start + 1;
+    while k < tpl.len() && tpl[k] != '>' {
+        k += 1;
+    }
+    if k >= tpl.len() {
+        return Err(terr("missing >"));
+    }
+    Ok((tpl[start + 1..k].iter().collect(), k + 1))
+}
+
+fn backslash(tpl: &[char], i: usize, ctx: &Ctx, st: &mut State) -> Result<usize, String> {
+    let j = i + 1;
+    let c = *tpl.get(j).ok_or_else(|| terr("dangling backslash"))?;
+    let next = j + 1;
+    let simple = match c {
+        '\\' => Some('\\'),
+        '/' => Some('/'),
+        '{' => Some('{'),
+        '}' => Some('}'),
+        'n' => Some('\n'),
+        't' => Some('\t'),
+        'r' => Some('\r'),
+        'b' => Some('\u{8}'),
+        'v' => Some('\u{b}'),
+        'f' => Some('\u{c}'),
+        'a' => Some('\u{7}'),
+        'e' => Some('\u{1b}'),
+        _ => None,
+    };
+    if let Some(ch) = simple {
+        st.emit(ch)?;
+        return Ok(next);
+    }
+    match c {
+        'E' => {
+            st.persistent = 0;
+            st.oneshot = 0;
+        }
+        'U' => st.persistent = b'U',
+        'L' => st.persistent = b'L',
+        'u' => st.oneshot = b'u',
+        'l' => st.oneshot = b'l',
+        'Q' => return quoted(tpl, j, st),
+        'x' => return hex(tpl, j, st),
+        'o' => return octal(tpl, j, st),
+        'c' => return control(tpl, j, st),
+        '0'..='9' => {
+            let (n, nxt) = digits(tpl, j);
+            st.emit_str(group_value(ctx, n)?)?;
+            return Ok(nxt);
+        }
+        'g' => return gform(tpl, j, ctx, st),
+        _ => return Err(terr(format!("unknown escape \\{}", c))),
+    }
+    Ok(next)
+}
+
+/// `\Q...\E` literal span; the terminating `\E` also cancels case forcing.
+fn quoted(tpl: &[char], q: usize, st: &mut State) -> Result<usize, String> {
+    let start = q + 1;
+    let mut k = start;
+    let (end, next) = loop {
+        if k >= tpl.len() {
+            break (tpl.len(), tpl.len());
+        }
+        if tpl[k] == '\\' && k + 1 < tpl.len() && tpl[k + 1] == 'E' {
+            break (k, k + 2);
+        }
+        k += 1;
+    };
+    for c in &tpl[start..end] {
+        st.emit(*c)?;
+    }
+    if end < next {
+        st.persistent = 0;
+        st.oneshot = 0;
+    }
+    Ok(next)
+}
+
+fn hex(tpl: &[char], x: usize, st: &mut State) -> Result<usize, String> {
+    let (v, next) = if tpl.get(x + 1) == Some(&'{') {
+        braced_code(tpl, x + 1, 16)?
+    } else {
+        let mut k = x + 1;
+        let mut v = 0u32;
+        let mut n = 0;
+        while n < 2 {
+            match tpl.get(k).and_then(|c| c.to_digit(16)) {
+                Some(d) => {
+                    v = v * 16 + d;
+                    k += 1;
+                    n += 1;
+                }
+                None => break,
+            }
+        }
+        if n == 0 {
+            return Err(terr("missing hex digits"));
+        }
+        (v, k)
+    };
+    st.emit(char::from_u32(v).ok_or_else(|| terr("bad code point"))?)?;
+    Ok(next)
+}
+
+/// `\o{ddd}` octal code point.
+fn octal(tpl: &[char], o: usize, st: &mut State) -> Result<usize, String> {
+    let (v, next) = braced_code(tpl, o + 1, 8)?;
+    st.emit(char::from_u32(v).ok_or_else(|| terr("bad code point"))?)?;
+    Ok(next)
+}
+
+/// Reads `{digits}` in `radix` starting at the `{`; returns (value, next index).
+fn braced_code(tpl: &[char], open: usize, radix: u32) -> Result<(u32, usize), String> {
+    if tpl.get(open) != Some(&'{') {
+        return Err(terr("expected brace"));
+    }
+    let mut k = open + 1;
+    let mut v = 0u32;
+    let mut any = false;
+    while k < tpl.len() && tpl[k] != '}' {
+        let d = tpl[k].to_digit(radix).ok_or_else(|| terr("bad digit"))?;
+        v = v * radix + d;
+        any = true;
+        k += 1;
+    }
+    if k >= tpl.len() {
+        return Err(terr("missing }"));
+    }
+    if !any {
+        return Err(terr("empty escape"));
+    }
+    Ok((v, k + 1))
+}
+
+/// `\cA` -> control char.
+fn control(tpl: &[char], c: usize, st: &mut State) -> Result<usize, String> {
+    let ch = *tpl.get(c + 1).ok_or_else(|| terr("missing control char"))?;
+    if !ch.is_ascii() {
+        return Err(terr("bad control char"));
+    }
+    st.emit(char::from_u32((ch as u32) & 0x1f).unwrap())?;
+    Ok(c + 2)
+}
+
+/// `\g<name>` / `\g<number>`.
+fn gform(tpl: &[char], g: usize, ctx: &Ctx, st: &mut State) -> Result<usize, String> {
+    if tpl.get(g + 1) != Some(&'<') {
+        return Err(terr("expected < after \\g"));
+    }
+    let (inner, next) = angle(tpl, g + 1)?;
+    if inner.is_empty() {
+        return Err(terr("empty \\g<>"));
+    }
+    let idx = if inner.chars().all(|c| c.is_ascii_digit()) {
+        inner.parse::<usize>().map_err(|_| terr("bad group number"))?
+    } else if inner.chars().next().map(|c| c.is_ascii_alphabetic() || c == '_').unwrap_or(false) {
+        ctx.named(&inner)?
+    } else {
+        return Err(terr("bad \\g<> reference"));
+    };
+    st.emit_str(group_value(ctx, idx)?)?;
+    Ok(next)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn caps(pairs: &[Option<(usize, usize)>]) -> Vec<Option<(usize, usize)>> {
+        pairs.to_vec()
+    }
+    fn nms(pairs: &[(&str, usize)]) -> Vec<(String, usize)> {
+        pairs.iter().map(|(n, i)| (n.to_string(), *i)).collect()
+    }
+
+    #[test]
+    fn dollar_forms() {
+        let sp = caps(&[Some((1, 4)), Some((2, 3))]);
+        let nm = nms(&[("word", 1)]);
+        assert_eq!(expand("+$1$0$1+", "=abc=", &sp, &nm, usize::MAX).unwrap(), "+babcb+");
+        assert_eq!(expand("$$", "a", &sp, &nm, usize::MAX).unwrap(), "$");
+        assert_eq!(expand("$$$1", "=abc=", &sp, &nm, usize::MAX).unwrap(), "$b");
+        assert_eq!(expand("%1$1", "=abc=", &sp, &nm, usize::MAX).unwrap(), "%1b");
+    }
+
+    #[test]
+    fn perl_dollar_forms() {
+        let s = "xaby";
+        let sp = caps(&[Some((1, 3)), Some((1, 2)), Some((2, 3))]);
+        assert_eq!(expand("[$&]", s, &sp, &[], usize::MAX).unwrap(), "[ab]");
+        assert_eq!(expand("[$`]", s, &sp, &[], usize::MAX).unwrap(), "[x]");
+        assert_eq!(expand("[$']", s, &sp, &[], usize::MAX).unwrap(), "[y]");
+        assert_eq!(expand("[$_]", s, &sp, &[], usize::MAX).unwrap(), "[xaby]");
+    }
+
+    #[test]
+    fn named_and_braced() {
+        let sp = caps(&[Some((0, 1)), Some((0, 1))]);
+        let nm = nms(&[("w", 1)]);
+        assert_eq!(expand("<$w>", "a", &sp, &nm, usize::MAX).unwrap(), "<a>");
+        assert_eq!(expand("<${w}>", "a", &sp, &nm, usize::MAX).unwrap(), "<a>");
+        assert_eq!(expand("<${1}>", "a", &sp, &nm, usize::MAX).unwrap(), "<a>");
+        assert_eq!(expand("[$<w>]", "a", &sp, &nm, usize::MAX).unwrap(), "[a]");
+    }
+
+    #[test]
+    fn conditional_forms() {
+        let set = caps(&[Some((0, 2)), Some((0, 1)), Some((1, 2))]);
+        let unset = caps(&[Some((0, 1)), Some((0, 1)), None]);
+        assert_eq!(expand("${2:-D}", "ab", &set, &[], usize::MAX).unwrap(), "b");
+        assert_eq!(expand("${2:-D}", "a", &unset, &[], usize::MAX).unwrap(), "D");
+        assert_eq!(expand("${2:-$1}", "a", &unset, &[], usize::MAX).unwrap(), "a");
+        assert_eq!(expand("${2:+S:U}", "ab", &set, &[], usize::MAX).unwrap(), "S");
+        assert_eq!(expand("${2:+S:U}", "a", &unset, &[], usize::MAX).unwrap(), "U");
+        // Mark is unrepresentable in this interface; always empty.
+        assert_eq!(expand("${*MARK}", "a", &unset, &[], usize::MAX).unwrap(), "");
+    }
+
+    #[test]
+    fn escapes() {
+        let sp = caps(&[Some((0, 1)), Some((0, 1))]);
+        let cases: &[(&str, &str)] = &[
+            ("\\x41", "A"),
+            ("\\x{41}", "A"),
+            ("\\o{101}", "A"),
+            ("\\cA", "\u{1}"),
+            ("\\n", "\n"),
+            ("\\t", "\t"),
+            ("\\b", "\u{8}"),
+            ("\\v", "\u{b}"),
+            ("\\\\", "\\"),
+            ("\\/", "/"),
+            ("\\{", "{"),
+            ("a\\Eb", "ab"),
+            ("\\Q$1\\E", "$1"),
+            ("\\1", "a"),
+            ("\\g<1>", "a"),
+            ("%1", "%1"),
+        ];
+        for (tpl, want) in cases {
+            assert_eq!(expand(tpl, "a", &sp, &[], usize::MAX).unwrap(), *want, "{}", tpl);
+        }
+        assert_eq!(expand("\\g<w>", "a", &sp, &nms(&[("w", 1)]), usize::MAX).unwrap(), "a");
+    }
+
+    #[test]
+    fn case_forcing() {
+        let sp = caps(&[Some((0, 1)), Some((0, 1))]);
+        let up = "a";
+        let lo = "A";
+        assert_eq!(expand("\\U$1\\E", up, &sp, &[], usize::MAX).unwrap(), "A");
+        assert_eq!(expand("\\u$1", up, &sp, &[], usize::MAX).unwrap(), "A");
+        assert_eq!(expand("\\L$1\\E", lo, &sp, &[], usize::MAX).unwrap(), "a");
+        assert_eq!(expand("\\l$1", lo, &sp, &[], usize::MAX).unwrap(), "a");
+        assert_eq!(expand("\\Uaa\\Lbb\\E", "x", &sp, &[], usize::MAX).unwrap(), "AAbb");
+        assert_eq!(expand("\\U$1\\E$1", up, &sp, &[], usize::MAX).unwrap(), "Aa");
+        assert_eq!(expand("\\l\\Uab\\E", "x", &sp, &[], usize::MAX).unwrap(), "aB");
+        assert_eq!(expand("\\u\\Lab\\E", "x", &sp, &[], usize::MAX).unwrap(), "Ab");
+    }
+
+    #[test]
+    fn malformed_errors() {
+        let sp = caps(&[Some((0, 1)), Some((0, 1)), None]);
+        let nm = nms(&[("w", 1)]);
+        for tpl in ["x$", "${1", "$9", "$nope", "$2", "${1:?x}", "\\Z", "\\g{w}", "[$<w]"] {
+            let r = expand(tpl, "a", &sp, &nm, usize::MAX);
+            assert!(r.is_err(), "{} => {:?}", tpl, r);
+            assert!(
+                r.unwrap_err().starts_with("REGEX_TEMPLATE_ERROR"),
+                "{} => wrong prefix",
+                tpl
+            );
+        }
+    }
+
+    #[test]
+    fn output_limit() {
+        let sp = caps(&[Some((0, 1)), Some((0, 1))]);
+        let e = expand("\\U$1\\E$1", "a", &sp, &[], 1).unwrap_err();
+        assert!(e.starts_with("REGEX_OUTPUT_LIMIT"), "{}", e);
+        assert_eq!(expand("\\U$1\\E$1", "a", &sp, &[], 2).unwrap(), "Aa");
+        assert_eq!(expand("\\U$1\\E$1", "a", &sp, &[], usize::MAX).unwrap(), "Aa");
+    }
+}
diff --git a/spike/fancy-regex-probe.lua b/spike/fancy-regex-probe.lua
new file mode 100644
index 00000000..3b119ccd
--- /dev/null
+++ b/spike/fancy-regex-probe.lua
@@ -0,0 +1,136 @@
+-- Bounded evidence only. Unsafe-reference checks require the Rust-safe spike adapter.
+local M = {}
+function M.init()
+  require "core.regex"
+  local core = require "core"
+  core.threads, core.log_items = setmetatable({}, { __mode = "k" }), {}
+  local mode = os.getenv("FANCY_CASE") or "dialect"
+  if mode == "workload" then
+    assert(type(regex.set_limits) == "function", "candidate-only workload sweep")
+    regex.set_limits(assert(tonumber(os.getenv("FANCY_WORK"))), assert(tonumber(os.getenv("FANCY_OUTPUT"))))
+    return require("regex-release-baseline").init()
+  end
+  local checks, failures = 0, 0
+  local function pack(v)
+    local a = {}
+    for i = 1, v.n do
+      a[i] = type(v[i]) == "string" and string.format("%q", v[i]):gsub("\\\n", "\\n") or tostring(v[i])
+    end
+    return table.concat(a, " | ")
+  end
+  local function check(id, expected, fn)
+    local r = table.pack(pcall(fn))
+    local got = { n = r.n - 1 }; table.move(r, 2, r.n, 1, got)
+    local ok = r[1] and got.n == expected.n
+    for i = 1, expected.n do ok = ok and got[i] == expected[i] end
+    checks = checks + 1
+    if not ok then failures = failures + 1 end
+    print((ok and "PASS " or "FAIL ") .. id .. ":" .. (got.n > 0 and " " .. pack(got) or ""))
+    if not ok then print("expected:" .. (expected.n > 0 and " " .. pack(expected) or "")) end
+  end
+  local function errors(id, fn, prefix)
+    local started = system.get_time()
+    check(id, table.pack(false, true), function()
+      local ok, msg = pcall(fn)
+      return ok, not ok and tostring(msg):find(prefix, 1, true) ~= nil
+    end)
+    if mode == "limits" then
+      local elapsed = system.get_time() - started
+      print(string.format("LIMIT\t%s\t-\t%.6f\t%s",id,elapsed,prefix))
+      check(id.."_under_second",table.pack(true),function() return elapsed<1 end)
+    end
+  end
+  if mode == "dialect" then
+    local cases = {
+      {"word_non_ascii", "\\w", "é", table.pack()},
+      {"digit_non_ascii", "\\d", "٣", table.pack()},
+      {"space_non_ascii", "\\s", "\194\160", table.pack()},
+      {"horizontal_space", "\\h", " ", table.pack(1,2)},
+      {"Q_pattern_quote", [[\Qa.b\E]], "a.b", table.pack(1,4)},
+      {"absolute_start_notbol", [[\Aa]], "a", table.pack(1,2), 1},
+      {"absolute_end_noteol", [[a\z]], "a", table.pack(1,2), 2},
+      {"global_empty_mixed", nil, nil, table.pack("---",3)},
+    }
+    for _,c in ipairs(cases) do
+      check(c[1], c[4], function()
+        if c[1] == "global_empty_mixed" then return regex.gsub("(?:|a)", "a", "-") end
+        return regex.cmatch(c[2], c[3], 1, c[5] or 0)
+      end)
+    end
+    require "plugins.language_js"
+    local js = require("core.syntax").get("test.js", "")
+    for i,p in ipairs(js.patterns) do
+      local r = p.regex
+      if type(r) == "string" then r = {r} end
+      if r then
+        for j = 1, math.min(#r,2) do
+          local s = r[j]
+          local compiled, err = regex.compile(s)
+          print("JS_PATTERN " .. i .. ":" .. j .. " " .. string.format("%q", s) .. " => " .. (compiled and "OK" or tostring(err)))
+        end
+      end
+    end
+  else
+    assert(type(regex.set_limits) == "function", "candidate-only: never run these cases on raw-pointer reference")
+    if mode == "safety" then
+      check("invalid_pattern_utf_compile_pair", table.pack(true,"string"), function()
+        local p,e=regex.compile("\255"); return p==nil,type(e)
+      end)
+      check("invalid_flag_byte_ignored", table.pack(1,2), function()
+        return regex.cmatch(regex.compile("a","\255"),"a")
+      end)
+      check("middle_cmatch", table.pack(1,2,nil,nil,1,2), function() return regex.cmatch("(a)?(b)","b") end)
+      check("middle_find_offsets", table.pack(1,1,nil,nil,1,1), function() return regex.find_offsets("(a)?(b)","b") end)
+      check("middle_find", table.pack(1,1,nil,"b"), function() return regex.find("(a)?(b)","b") end)
+      check("middle_match", table.pack(nil,"b"), function() return regex.match("(a)?(b)","b") end)
+      check("middle_gmatch", table.pack(nil,"b"), function() return regex.gmatch("(a)?(b)","b")() end)
+      check("trailing_omitted", table.pack(1,2,1,2), function() return regex.cmatch("(a)(b)?","a") end)
+      check("iterator_keeps_pattern_after_GC", table.pack("a","a",0), function()
+        local p = regex.compile("a")
+        local iter = regex.gmatch(p,"aa")
+        p=nil; collectgarbage("collect"); collectgarbage("collect")
+        local a,b=iter(),iter(); return a,b,select("#",iter())
+      end)
+      errors("bad_handle", function() return regex.cmatch({},"a") end, "REGEX_HANDLE_ERROR")
+      errors("foreign_handle", function() return regex.cmatch({io.stdout},"a") end, "REGEX_HANDLE_ERROR")
+      errors("offset_past_end", function() return regex.cmatch(".","é",4) end, "REGEX_OFFSET_ERROR")
+      errors("offset_inside_utf8", function() return regex.cmatch(".","é",2) end, "REGEX_OFFSET_ERROR")
+      check("offset_at_eof", table.pack(3,3,3,3), function() return regex.cmatch("()","é",3) end)
+      check("mixed_empty_nonempty_iteration", table.pack(1,"a",2,0), function()
+        local i=regex.gmatch("(?:|a)","a")
+        local a,b,c=i(),i(),i(); return a,b,c,select("#",i())
+      end)
+      check("iterator_keeps_prefix", table.pack("a"), function() return regex.gmatch("(?<=b)a","ba",2)() end)
+      check("notempty_same_position", table.pack(1,2), function() return regex.cmatch("(?:|b)","b",1,regex.NOTEMPTY) end)
+    elseif mode == "limits" then
+      for _,work in ipairs({1000,10000,100000,1000000}) do
+        regex.set_limits(work,8*1024*1024)
+        for _,c in ipairs({ {"backreference_fail", "(a|aa)+\\1b", string.rep("a",5000)},
+                             {"nested_backreference_fail", "((a|aa)+)+\\1b", string.rep("a",128)} }) do
+          local p = assert(regex.compile(c[2]))
+          local t=system.get_time()
+          local ok,msg=pcall(regex.cmatch,p,c[3])
+          local elapsed=system.get_time()-t
+          print(string.format("LIMIT\t%s\t%d\t%.6f\t%s",c[1],work,elapsed,tostring(msg):match("REGEX_WORK_LIMIT") or tostring(ok)))
+          check(c[1].."_"..work,table.pack(false,true,true),function()
+            return ok, tostring(msg):find("REGEX_WORK_LIMIT",1,true)~=nil, elapsed<1
+          end)
+        end
+      end
+      regex.set_limits(1000000,65536)
+      errors("output_exhaustion_no_partial", function()
+        return regex.gsub("a",string.rep("a",4096),string.rep("x",1024))
+      end,"REGEX_OUTPUT_LIMIT")
+      regex.set_limits(1000,8*1024*1024)
+      errors("aggregate_call_quota", function() return regex.gsub("a",string.rep("a",5000),"b") end,"REGEX_WORK_LIMIT")
+      regex.set_limits(1,8*1024*1024)
+      check("delegated_scan_ignores_character_work_quota",table.pack(0),function()
+        return select("#",regex.cmatch("z",string.rep("a",1024*1024)))
+      end)
+    else error("unknown FANCY_CASE") end
+  end
+  print(string.format("SUMMARY mode=%s checks=%d failures=%d",mode,checks,failures))
+  os.exit(failures==0 and 0 or 1)
+end
+function M.run() end
+return M
diff --git a/spike/regex-acceptance-cases.lua b/spike/regex-acceptance-cases.lua
